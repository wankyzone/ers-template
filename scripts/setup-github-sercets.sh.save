#!/bin/bash
# scripts/setup-github-secrets.sh
# This script loads your .env file and creates matching GitHub Actions secrets automatically.

set -e

if [ ! -f ".env" ]; then
  echo "❌ .env file not found in project root."
  exit 1
fi

echo "🚀 Setting up GitHub Actions secrets..."

# Loop through all non-empty, non-commented lines in .env
while IFS='=' read -r key value; do
  if [[ ! -z "$key" && ! "$key" =~ ^# ]]; then
    gh secret set "$key" --body "$value"
    echo "✅ Set secret: $key"
  fi
done < .env

echo "🎉 All secrets uploaded successfully!"

