{
  "name": "@ers/client",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:backend": "pnpm --filter backend dev",
    "dev:admin": "pnpm --filter @ers/admin dev",
    "dev:all": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter @ers/admin dev\" \"pnpm --filter @ers/client dev\"",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check ."
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@expo/metro-runtime": "~3.2.3",
    "@types/react": "~18.2.79",
    "expo": "~54.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.0.0",
    "concurrently": "^8.0.0"
  }
}
