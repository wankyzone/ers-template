import { Router } from "express";

const router = Router();

// TEMP: in-memory store until DB is wired
const errands: any[] = [];

router.get("/", (_req, res) => {
  return res.json(errands);
});

router.post("/", (req, res) => {
  try {
    const { title, description } = req.body;

    if (!title || typeof title !== "string") {
      return res.status(400).json({ error: "title is required" });
    }

    const newErrand = {
      id: String(Date.now()),
      title,
      description: description || "",
      status: "pending",
      createdAt: new Date().toISOString(),
    };

    errands.push(newErrand);

    return res.status(201).json(newErrand);
  } catch (err) {
    console.error("Error creating errand:", err);
    return res.status(500).json({ error: "Internal server error" });
  }
});

export { router as errandsRouter };


