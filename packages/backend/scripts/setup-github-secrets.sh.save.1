#!/bin/bash
# scripts/setup-github-secrets.sh

set -e

if [ ! -f "../../.env" ]; then
  echo "❌ .env file not found at project root (../../.env)."
  exit 1
fi

echo "🚀 Setting up GitHub Actions secrets for backend..."

while IFS='=' read -r key value; do
  if [[ ! -z "$key" && ! "$key" =~ ^# ]]; then
    gh secret set "$key" --body "$value"
    echo "✅ Set secret: $key"
  fi
done < ../../.env

echo "🎉 All secrets uploaded successfully!"

