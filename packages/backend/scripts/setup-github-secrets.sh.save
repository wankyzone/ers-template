#!/bin/bash
set -e

REPO="wankyzone/ers-template"
ENV_PATH=".env"

if [ ! -f "$ENV_PATH" ]; then
  echo "❌ .env not found!"
  exit 1
fi

if ! command -v gh &> /dev/null; then
  echo "⚙️ Installing GitHub CLI..."
  sudo apt update && sudo apt install gh -y
fi

echo "🔐 Authenticating..."
gh auth status || gh auth login

echo "🚀 Syncing secrets to $REPO..."
while IFS='=' read -r key value; do
  if [[ -z "$key" || "$key" =~ ^# ]]; then
    continue
  fi
  key=$(echo "$key" | xargs)
  value=$(echo "$value" | xargs)
  gh secret set "$key" --body "$value" --repo "$REPO" >/dev/null 2>&1
  echo "✅ Synced: $key"
done < "$ENV_PATH"

echo "🎉 All secrets uploaded successfully!"
