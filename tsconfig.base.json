{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@ers/db": ["packages/db/src/index.ts"],
      "@ers/db/*": ["packages/db/src/*"],
      "@ers/auth": ["apps/api/auth/src/index.ts"],
      "@ers/auth/*": ["apps/api/auth/src/*"]
    }
  },
  "include": ["apps", "packages"]
}
