{
  "name": "ers-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter backend dev",
    "dev:admin": "pnpm --filter @ers/admin dev",
    "dev:client": "pnpm --filter @ers/client dev",
    "dev:all": "pnpm --filter @ers/client dev:all",
    "lint": "eslint .",
    "healthcheck": "echo \"Running health checks...\" && pnpm typecheck && pnpm -r run lint",
    "typecheck": "pnpm --filter backend exec tsc --noEmit && pnpm --filter @ers/admin exec tsc --noEmit",
    "orchestrator:replay-from-seed": "pnpm --filter backend db:replay-seed -- --profile=${PROFILE:-medium} && pnpm --filter @ers/orchestrator replay:seed-jobs -- --profile=${PROFILE:-medium}"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "bcrypt": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.3",
      "@types/react-dom": "18.3.0"
    }
  }
}
