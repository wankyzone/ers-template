{
  "name": "ers-client",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/backend",
    "packages/client/packages/admin"
  ],
  "scripts": {
    "dev:backend": "pnpm --filter @ers/backend dev",
    "dev:admin": "pnpm --filter @ers/admin dev",
    "dev:all": "concurrently \"pnpm dev:backend\" \"pnpm dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "supertest": "^7.1.4",
    "vitest": "^4.0.6",
    "pnpm": {
      "overrides": {
        "ioredis": "5.8.2"
      }
    }
  }
}
