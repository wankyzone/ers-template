{
  "name": "ers-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter backend dev",
    "dev:admin": "pnpm --filter @ers/admin dev",
    "dev:client": "pnpm --filter @ers/client dev",
    "dev:all": "pnpm --filter @ers/client dev:all",
    "lint": "eslint .",
    "healthcheck": "echo \"Running health checks...\" && pnpm -r exec tsc --noEmit && pnpm -r run lint",
    "typecheck": "tsc --noEmit",
    "orchestrator:replay-from-seed": "pnpm --filter backend db:replay-seed -- --profile=${PROFILE:-medium} && pnpm --filter @ers/orchestrator replay:seed-jobs -- --profile=${PROFILE:-medium}"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
